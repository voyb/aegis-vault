# Secrets - never commit these
key.txt
github.txt
*.vlt

# PyInstaller build output (icon source files in icon/ are NOT ignored - CI needs them)
build/
dist/
__pycache__/
*.pyc

# OS/editor cruft
.DS_Store
Thumbs.db

# Local tooling / dev notes - not part of the published project
.token-optimizer/
.claude/
docs/

# Browser profiles hold the encrypted vault (localStorage) and the device key (IndexedDB). NEVER commit them.
profile/
profile-webview/
profile.bak*/
.aci/
tests/_*.mjs

# Signing material and release state must never be committed
release-key*
*.pem
*.key
id_ed25519*
.env
release-state/
*.manifest
*.manifest.sig
RELEASE.manifest*
